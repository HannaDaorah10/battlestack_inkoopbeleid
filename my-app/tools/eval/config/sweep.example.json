{
    // Kopieer dit bestand naar config/sweep.json en pas het aan. Regels met // zijn commentaar.
    "name": "adviseur-v1",

    // Jouw documenten, in tools/eval/corpus/<organisatie>/ (die map staat in .gitignore).
    // "dir" leest elk ondersteund bestand in die map in - de bestandsnaam zelf doet er niet toe,
    // dus een PDF hernoemen of vervangen vraagt geen wijziging hier.
    // De "organisatie" is niet optioneel: de app houdt organisaties gescheiden bij het zoeken,
    // dus een sweep die beide beleidsstukken door elkaar doorzoekt meet iets makkelijkers dan
    // wat de app werkelijk doet.
    "corpus": [
        { "dir": "corpus/ons-huis", "organisatie": "ons-huis" },
        { "dir": "corpus/welbions", "organisatie": "welbions" }
    ],

    "questions": "cases/vragen.jsonl",

    // LET OP - modelnamen. Deze sluis-tenant staat alleen EU-providers toe: bedrock, mistral,
    // nebius, scaleway, vertex en sluis. Een `openai/...`-model wordt geweigerd met
    // "provider `openai` (jurisdiction `US`) is not permitted by the tenant's residency policy".
    // Draai `pnpm eval:models` voor de actuele lijst van jouw tenant.

    // FASE 1 - alleen embeddings, geen chatmodel. Draai deze eerst.
    // Configuraties die alleen in topK verschillen delen een index, dus topK is bijna gratis.
    // De twee modellen hieronder geven vectoren van verschillende lengte (1536 en 4096). Voor de
    // harness maakt dat niets uit; in de app moet NUXT_RAG_EMBEDDING_DIMENSIONS bij de winnaar
    // passen (nu 1536, wat overeenkomt met cohere embed-v4).
    //
    // vertex/text-multilingual-embedding-002 stond hier ook, en staat ook in `pnpm eval:models`,
    // maar Google wijst hem af: "Publisher model ... was not found or your project does not have
    // access to it" in locations/eu. De gateway adverteert het model dus wel, maar het GCP-project
    // achter sluis.ai heeft er kennelijk (nog) geen toegang toe - dat is bij sluis.ai op te lossen,
    // niet hier. Zet hem pas terug zodra dat is bevestigd; een falend model laat de rest van de
    // sweep intact (zie "fouten" in samenvatting.md), maar meet natuurlijk zelf niets.
    "retrieval": {
        "embeddingModel": [
            "bedrock/eu.cohere.embed-v4:0",
            "nebius/Qwen/Qwen3-Embedding-8B"
        ],
        "maxChunkSize": [500, 700, 1000],
        "chunkOverlap": [100, 200],
        "topK": [5, 8]
    },

    // FASE 2 - hier zit het geld. Elke combinatie x elke vraag is een aanroep.
    // Draai altijd eerst met --dry-run om te zien hoeveel dat er zijn.
    "generation": {
        "model": [
            "bedrock/eu.anthropic.claude-sonnet-4-5-20250929-v1:0",
            "bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0",
            "mistral/mistral-large-latest"
        ],
        "temperature": [0, 0.3],
        // Laat topP op 1 staan tenzij je hem echt wilt onderzoeken: Anthropic weigert een verzoek
        // met temperature EN top_p tegelijk met een kale "Bad Request". Bij 1 stuurt de harness
        // hem niet mee (hij doet dan toch niets), waardoor de Claude-modellen gewoon werken.
        // Zet je hem op iets anders, dan mislukken de Claude-cellen - zichtbaar in het rapport.
        "topP": [1],
        "maxOutputTokens": [1200],
        "systemPrompt": [
            "prompts/adviseur-a-standaard.md",
            "prompts/adviseur-b-strikt.md"
        ],
        // Meerdere trekkingen van dezelfde instelling. Zet op 2 of 3 als je wilt zien hoeveel
        // een hogere temperature het antwoord laat variëren; bij temperature 0 heeft het weinig zin.
        "samples": 1
    },

    // Hoeveel aanroepen tegelijk. Hoger is sneller, maar levert eerder rate limits op.
    "concurrency": 4,

    // Harde bovengrens op het aantal aanroepen. De run stopt daar en zegt dat hij stopt.
    "maxCalls": 2000
}
