# .env.example: committed reference for the keys this project needs.
#
# Copy to .env and fill in real values, or run `battlestack install` to generate one.
# Keys left as `change-me` that are self-owned secrets (e.g. NUXT_SESSION_PASSWORD,
# NUXT_TOTP_ENCRYPTION_KEY) are auto-generated by `battlestack install`; the comment above
# each shows the equivalent `openssl rand` command if you prefer to set them yourself.
# External credentials (SMTP, OAuth, API keys) must be filled in by hand.

# App
# Dev/preview server port. Per-project to avoid collisions when running multiple battlestack projects side-by-side.
NUXT_PORT=3000

# Database
DB_NAME=app
# Host port mapped to postgres in docker-compose. Per-project to avoid collisions.
DB_PORT=5432
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Seed
# Used once by db:seed to create the initial admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me

# Session
# Used by nuxt-auth-utils to seal session cookies. Must be ≥ 32 chars.
# Generate a strong random value, e.g. `openssl rand -hex 32`. Leave as change-me and battlestack fills it on `battlestack install`.
NUXT_SESSION_PASSWORD=change-me

# Security
# Comma-separated origin allowlist for mutating requests (server/middleware/01.origin-check.ts). Empty in dev = allow all.
NUXT_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Dev-only opt-out for the (Postgres-backed, cross-replica) rate limiter so `battlestack test` / e2e runs don't exhaust the 10-attempt LOGIN bucket on the first run. **Never set on a production deployment**: it removes brute-force protection.
NUXT_RATE_LIMIT_DISABLED=false

# Email
# SMTP host. Defaults to the per-project Mailpit container (started by `battlestack up`). Switch to Mandrill or another SMTP provider in production.
NUXT_SMTP_HOST=smtp.mandrillapp.com
# Per-project host port for the project's Mailpit container.
NUXT_SMTP_PORT=587
# Dev-only: compose-side mirror of NUXT_SMTP_PORT, keeping docker-compose.yml and the Nuxt runtime in sync. Irrelevant in prod (real SMTP provider).
SMTP_PORT=1025
# Dev-only: host port for the project's Mailpit web UI. Visit http://localhost:$MAIL_UI_PORT. Irrelevant in prod.
MAIL_UI_PORT=8025
# Empty for mailpit. Set when targeting a real SMTP provider.
NUXT_SMTP_USERNAME=replace-me
NUXT_SMTP_PASSWORD=replace-me
# RFC 5322 from-address. Display name + email. Override to a verified sender before production.
NUXT_SMTP_FROM="Acme <no-reply@acme.com>"

# App
# Base URL emitted in password-reset / verification email links. Override for prod / gateway hostname.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# WebAuthn
# Relying-party id. Hostname only (no scheme/port). Pin in prod.
NUXT_WEBAUTHN_RP_ID=localhost
# User-visible name shown by the OS during passkey prompts.
NUXT_WEBAUTHN_RP_NAME="My App"

# Two-factor
# AES-256-GCM key for TOTP secrets at rest. Exactly 64 hex chars (32 bytes). NEVER commit. Rotate via re-setup.
# Generate a strong random value, e.g. `openssl rand -hex 32`. Leave as change-me and battlestack fills it on `battlestack install`.
NUXT_TOTP_ENCRYPTION_KEY=change-me
# Strict TOTP window. false (default) = ±60s tolerance so a code typed at the last second still verifies after submit latency/clock skew. Set true to tighten to ±30s.
NUXT_TOTP_STRICT=false

# Redis
# Presence-triggered: set → the limiter runs on Redis, failing over to Postgres via the circuit breaker. Unset → pure Postgres, same as without this feature. Safe to unset anywhere; Postgres alone is already correct.
NUXT_REDIS_URL=redis://:password@redis.example.com:6379
# Dev-only: host port mapped to the compose Redis container. Per-project to avoid collisions. Irrelevant in prod (managed Redis, or no Redis at all).
REDIS_PORT=6379

# Storage
# Dev uses 'us-east-1' for RustFS. Prod: Scaleway region (e.g. nl-ams).
NUXT_S3_REGION=nl-ams
# Dev points at local RustFS. Prod: Scaleway / S3-compatible endpoint.
NUXT_S3_ENDPOINT=https://s3.nl-ams.scw.cloud
NUXT_S3_BUCKET=my-bucket
# Optional. Base URL for PUBLIC download links (e.g. a CDN or public bucket domain). When set, `?mode=public` download URLs become `<base>/<key>`. Leave blank to derive `<endpoint>/<bucket>/<key>`. Only meaningful if the object/bucket is actually public.
NUXT_S3_PUBLIC_BASE_URL=https://cdn.example.com
# Dev: RustFS access key (default `rustfsadmin`). Prod: real access key.
NUXT_S3_ACCESS_KEY_ID=replace-me
# Dev: RustFS secret key. Prod: real secret.
NUXT_S3_SECRET_ACCESS_KEY=replace-me
# Dev-only: host port mapped to the RustFS S3 API container. Per-project to avoid collisions. Irrelevant in prod (managed S3).
S3_API_PORT=9000
# Dev-only: host port for the RustFS web console. Irrelevant in prod.
S3_CONSOLE_PORT=9001

# AI
# OpenAI-compatible AI gateway base URL: sluis.ai, a self-hosted LiteLLM proxy, or any compatible endpoint. Mastra calls it via @ai-sdk/openai-compatible. Required before AI features will work.
NUXT_AI_GATEWAY_URL=https://api.sluis.ai
# AI gateway API key (sluis.ai keys look like sk_live_...).
NUXT_AI_GATEWAY_KEY=sk_live_replace_me
# Default chat model id served by the gateway.
NUXT_AI_GATEWAY_CHAT_MODEL=openai/gpt-4o-mini
# Default embedding model id (used by RAG).
NUXT_AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional JSON object of extra request headers, e.g. {"X-Sluis-Residency":"eu-only"} for a per-request sluis.ai residency override.
NUXT_AI_GATEWAY_HEADERS=

# RAG
# Vector size. Must match the embedding model output.
NUXT_RAG_EMBEDDING_DIMENSIONS=1536
NUXT_RAG_MAX_CHUNK_SIZE=700
NUXT_RAG_CHUNK_OVERLAP=100
NUXT_RAG_TOP_K=5

# Playwright
# Used by the Playwright MCP server when asked to sign in.
PLAYWRIGHT_TEST_EMAIL=test@example.com
PLAYWRIGHT_TEST_PASSWORD=replace-me
